{
  "rules": {
    "boards": {
      ".read": true,
      "$land": {
        ".validate": "$land.matches(/^(math|hebrew|reading|english|geography|biology|memory|puzzle)$/)",
        "$game": {
          ".indexOn": ["k"],
          ".validate": "$game.matches(/^[a-z0-9_]{1,20}$/)",
          "$entry": {
            ".write": "auth != null && $entry.beginsWith(auth.uid + '_') && newData.exists() && (!data.exists() || newData.child('k').val() > data.child('k').val()) && newData.parent().parent().parent().parent().child('scoreRate').child(auth.uid).val() == now",
            ".validate": "newData.hasChildren(['name', 'grade', 'ms', 'k', 'at']) && $entry.matches(/^[A-Za-z0-9]{1,128}_[a-z0-9]{8}$/)",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
            "grade": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && newData.val() % 1 == 0" },
            "ms": { ".validate": "newData.isNumber() && newData.val() >= 1000 && newData.val() <= 99999999 && newData.val() % 1 == 0" },
            "k": { ".validate": "newData.isNumber() && newData.val() == newData.parent().child('grade').val() * 100000000 + 99999999 - newData.parent().child('ms').val()" },
            "at": { ".validate": "newData.val() == now" },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "scoreRate": {
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.isNumber() && newData.val() == now && (!data.exists() || now - data.val() >= 5000)"
      }
    },

    "analytics": {
      ".read": false,
      "sessions": {
        "$sid": {
          "meta": {
            ".write": "auth != null && !data.exists() && $sid.matches(/^sess_[a-z0-9]{1,16}_[a-z0-9]{1,16}$/)",
            ".validate": "newData.hasChildren(['started'])",
            "started": { ".validate": "newData.val() == now" },
            "clientStartedAt": { ".validate": "newData.isNumber()" },
            "userAgent": { ".validate": "newData.isString() && newData.val().length <= 400" },
            "language": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "viewport": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "screen": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "timezoneOffset": { ".validate": "newData.isNumber()" },
            "lastActivity": {
              ".write": "auth != null && data.parent().exists()",
              ".validate": "newData.val() == now"
            },
            "$other": { ".validate": false }
          },
          "events": {
            "$eventId": {
              ".write": "auth != null && !data.exists() && $sid.matches(/^sess_[a-z0-9]{1,16}_[a-z0-9]{1,16}$/)",
              ".validate": "newData.hasChildren(['type', 'ts'])",
              "type": { ".validate": "newData.isString() && newData.val().length <= 32" },
              "ts": { ".validate": "newData.val() == now" },
              "clientTs": { ".validate": "newData.isNumber()" },
              "initialScreen": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "isNewSession": { ".validate": "newData.isBoolean()" },
              "from": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "to": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "subject": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "level": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "outcome": { ".validate": "newData.isString() && newData.val().length <= 20" },
              "correct": { ".validate": "newData.isBoolean() || newData.isNumber()" },
              "responseMs": { ".validate": "newData.isNumber()" },
              "durationMs": { ".validate": "newData.isNumber()" },
              "answers": { ".validate": "newData.isNumber()" },
              "accuracy": { ".validate": "newData.isNumber()" },
              "avgResponseMs": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          }
        }
      }
    }
  }
}
